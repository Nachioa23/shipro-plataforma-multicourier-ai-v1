generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. NÚCLEO DEL NEGOCIO (Multi-Tenant)
// ==========================================
model Empresa {
  id     Int     @id @default(autoincrement())
  nombre String
  cuit   String  @unique
  activo Boolean @default(true)

  // TECH 1 (2026-06-18): apiKey ahora se almacena hasheada (HMAC-SHA256) en BD.
  // Plain text se devuelve UNA SOLA VEZ al rotar. Cliente debe guardarla.
  // apiKeyHash @unique permite lookup eficiente en proxy.ts authByApiKey.
  // apiKeyUltimos4 es display-only (UI: "Tu API Key termina en ABCD").
  apiKeyHash     String?   @unique
  apiKeyUltimos4 String?
  apiKeyActiva   Boolean   @default(true)
  apiKeyCreadaEn DateTime?

  // --- FINANZAS Y BILLETERA ---
  saldoActivo       Decimal @default(0) @db.Decimal(12, 2)
  modalidadPago     String  @default("POSTPAGO") // PREPAGO (Billetera) o POSTPAGO (Crédito)
  limiteDescubierto Decimal @default(0) @db.Decimal(12, 2) // Cuánto le permitimos adeudar

  ordenamientoDefault String @default("PRECIO_ASC") // PRECIO_ASC, SLA, HISTORICO

  // Modo B — política de empaquetado de TARIFA FIJA (no es empaquetado físico real).
  // Si empaqueModoBActivo=true, todos los envíos de la empresa cotizan como UN bulto con
  // estos parámetros fijos, sin importar el contenido real del carrito. Es una regla
  // COMERCIAL de tarifa, no un cálculo de bin-packing (eso es Modo A, futuro).
  // Solo son STORAGE; toman efecto cuando el rates callback los lea y arme el bulto fijo.
  empaqueModoBActivo  Boolean @default(false)
  empaqueModoBPesoKg  Float?
  empaqueModoBLargoCm Float?
  empaqueModoBAnchoCm Float?
  empaqueModoBAltoCm  Float?

  usuarios            Usuario[]
  envios              Envio[]
  manifiestos         Manifiesto[]
  credenciales        CredencialCourier[]
  encuestasNPS        EncuestaNPS[]
  encuestasNPSEmpresa EncuestaNPSEmpresa[]
  movimientos         MovimientoFinanciero[]
  liquidaciones       LiquidacionMensual[] // NUEVO: Agrupador de facturas a fin de mes
  depositos           Deposito[] // DEUDA 4: depósitos físicos del cliente
  tiendasTiendanube   TiendaTiendanube[] // DEUDA 144: tiendas Tiendanube vinculadas (1 empresa → N tiendas)
  tokensVinculacionTiendanube TokenVinculacionTiendanube[] // Tokens de un solo uso para el link de instalación OAuth (Momento 1)

  // DEUDA 29: si true, el cliente puede usar credenciales Shipro (Modelo A) al activar
  // couriers. Inmutabilidad direccional: gerente_cliente puede ir A→B (obtener
  // credenciales propias), pero NO B→A. Decidido por admin_shipro en onboarding.
  modeloAHabilitado Boolean @default(false)

  // DEUDA 22 (2026-06-18): Suspension automatica por exceso de limiteDescubierto.
  // suspendida=true bloquea creacion nueva de envios (HTTP 400 + code CUENTA_SUSPENDIDA).
  // Trigger en lib/envios/crear.ts post-debit cuando saldoActivo <= -(limiteDescubierto * 1.5).
  // Reactivacion automatica cuando saldoActivo >= -(limiteDescubierto * 0.5) post-recarga.
  suspendida        Boolean   @default(false)
  fechaSuspension   DateTime?
  fechaReactivacion DateTime?

  // DEUDA 17 (2026-06-22): Direccion fiscal del cliente (datos AFIP/facturacion).
  // Schema-level opcional (existing rows pre-DEUDA-17 no las tienen); validacion
  // obligatoria a nivel endpoints (POST /api/clientes en Fase A).
  direccionFiscalCalle     String?
  direccionFiscalAltura    String?
  direccionFiscalCP        String?
  direccionFiscalLocalidad String?
  direccionFiscalProvincia String?

  // DEUDA 17: notas privadas del admin Shipro sobre el cliente (no visible al cliente).
  notasInternas String?

  // DEUDA 17: gate del wizard obligatorio. False post-creacion via Fase A,
  // true cuando el gerente completa los 4 pasos del onboarding.
  // Middleware redirect a /onboarding mientras sea false.
  onboardingCompletado Boolean @default(false)

  // DEUDA 132 Paso 5a (2026-08-25): campo tarifaPlanaRespaldo per-empresa
  // DROPEADO. Reemplazado por CredencialCourier.tarifaPlanaRespaldoCourier
  // (per-courier). El rescate ya no es un default de empresa; se configura por
  // courier al armar el mix. Ver DEUDA 132.

  createdAt               DateTime                 @default(now())
  reglasRuteo             ReglaRuteo[]
  // DEUDA 32+37 (Fase J): registro de cotizaciones que devolvieron cero couriers.
  registrosCoberturaVacia RegistroCoberturaVacia[]
  // DEUDA 19: audit log de cambios sensibles (credenciales/config).
  auditoriasConfiguracion AuditoriaConfiguracion[]
  // DEUDA 10 (D-10-5): fees por operacion Modelo B de esta empresa.
  operacionFees           OperacionFee[]
}

// ==========================================
// 1.6 DEPÓSITOS FÍSICOS (DEUDA 4)
// Cada empresa puede tener N depósitos. Uno marcado como predeterminado
// se usa por default en e-commerces y cuando hay un solo depósito.
// El cliente elige al crear envío manual cuando hay >1.
// ==========================================
model Deposito {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre           String
  esPredeterminado Boolean @default(false)
  activo           Boolean @default(true)

  // Contacto del depósito (para coordinar colectas)
  contactoNombre   String
  contactoTelefono String
  contactoEmail    String?

  // Dirección física (datos para etiqueta y CP origen)
  direccionCalle  String
  direccionAltura String
  direccionPiso   String?
  direccionDpto   String?
  codigoPostal    String
  localidad       String
  provincia       String
  pais            String  @default("Argentina")

  // DEUDA 29 Sub-fase 2.B.0: coordenadas geocodificadas vía Google Maps.
  // Pobladas al crear/editar el depósito (cambios de dirección) y por
  // scripts/backfill-coordenadas-depositos.ts para filas legacy.
  // Nullable: si Google falla o no resuelve, el depósito queda sin coords
  // (degradación elegante: el endpoint de sucursales cercanas excluye/aplica
  // fallback según política del caller).
  latitud               Float?
  longitud              Float?
  ultimaGeocodificacion DateTime?

  // Horarios estructurados (JSON: 7 días × 3 franjas estándar 09-12 / 12-15 / 15-18)
  horarios String

  observaciones String?

  // Soft delete (DEUDA 4): los depósitos no se borran físicamente porque
  // tienen valor histórico (envíos los referencian). El endpoint DELETE
  // en realidad hace UPDATE eliminado=true, activo=false, esPredeterminado=false.
  // La FK desde Envio usa onDelete: Restrict (defense-in-depth: aunque el
  // endpoint nunca borra, la BD rechaza un DELETE accidental).
  eliminado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enviosOrigen Envio[]

  // DEUDA 29: sucursal preferida del cliente para imposición/recolección, por courier.
  sucursalesPreferidas DepositoSucursalPreferida[]

  // DEUDA 29 Sub-fase 6.D.1: configuración operativa de cada courier en este depósito.
  courierConfigs DepositoCourierConfig[]

  // DEUDA 29 Sub-fase 6.D (rectificación, 2026-05-19): courier consolidador único por depósito.
  // Decisión #49: el recolector va aquí (no en DepositoCourierConfig) porque hay 1 sólo
  // por depósito como regla operativa estructural.
  courierRecolectorId Int?
  courierRecolector   Courier? @relation("DepositoRecolector", fields: [courierRecolectorId], references: [id], onDelete: SetNull)

  @@index([empresaId])
}

model Usuario {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  nombre   String
  rol      String @default("operador_cliente")

  // DEUDA 17 (2026-06-22): telefono WhatsApp del usuario.
  // Formato esperado: internacional estricto +5491134567890 (validado en endpoints).
  // Schema-level opcional (existing admin row no lo tiene); obligatorio en POST.
  telefono String?

  // DEUDA 17: marca password como temporal (recien creado via admin Fase A).
  // Login post-creacion fuerza cambio en primer ingreso (wizard paso 1).
  passwordTemporal Boolean @default(false)

  // DEUDA 17.F.1 (2026-06-23): soft-delete para desactivar operadores
  // sin perder historico de envios/audit. Gerente puede toggle desde "Mi equipo".
  // Usuarios desactivados NO pueden loguearse (check en lib/auth.ts authorize).
  activo Boolean @default(true)

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // Metrica 1.3 (DEUDA 39, 2026-06-11): historial de votos NPS del usuario.
  encuestasNPSEmpresa EncuestaNPSEmpresa[]

  // FASE 2 sub 1 (config variables tarifa, 2026-07-31): auditor de ajustes
  // masivos del Fee. Nullable en el evento (SetNull en el FK) para no perder
  // el registro si el usuario admin es dado de baja.
  ajustesMasivosFee AjusteMasivoFee[]
}

model Courier {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  // --- CAMPOS NUEVOS PARA EL ABM MAESTRO ---
  emailSoporte      String?
  telefonoSoporte   String?
  contactoComercial String?
  logoUrl           String?

  // DEUDA 73 (SMO): Seguro Mínimo de Shipro. Precio FIJO que Shipro le cobra al cliente por courier
  // (ej. $121,50 para Andreani). Distinto del costo que factura el intermediario
  // (CourierIntermediario.seguroFijoIntermediarioConIva, ej. $90 de Mocis). La diferencia es el margen.
  // Interruptor apagado por defecto: se activa por courier cuando Shipro decide cobrarlo.
  smoActivo                Boolean @default(false)
  smoPrecioAlClienteConIva Decimal @default(0) @db.Decimal(12, 2)

  // --- DEUDA 29: Capacidades de cadena ---
  // Se usan en pre-filtro al cotizar y al validar combinaciones cliente↔courier.
  // Cada courier real declara qué puede hacer; la plataforma filtra candidatos.
  puedeRecogerDomicilio           Boolean @default(true)
  puedeConsolidar                 Boolean @default(false)
  cpDepositoConsolidador          String?
  // DEUDA 29 Sub-fase 6.D.1: CP del depósito central del courier consolidador.
  // Se usa cuando este courier es elegido como recolector por un cliente —
  // los couriers de última milla cotizan desde este CP en vez del CP del
  // depósito del cliente. NULL para couriers no consolidadores.
  // DEUDA 32+37: direccion estructurada del deposito consolidador.
  // Reemplaza progresivamente a cpDepositoConsolidador (se mantiene por
  // compatibilidad hasta migrar los consumidores). Autocompletada con
  // Google Maps (mismo metodo que Deposito). NULL para no consolidadores.
  cpDepositoConsolidadorCalle     String?
  cpDepositoConsolidadorNumero    String?
  cpDepositoConsolidadorCp        String?
  cpDepositoConsolidadorLocalidad String?
  cpDepositoConsolidadorProvincia String?
  puedeEntregarDomicilio          Boolean @default(true)
  puedeEntregarSucursal           Boolean @default(false)
  aceptaDropOff                   Boolean @default(false)

  // --- DEUDA 29: Capacidades de logística inversa (granulares) ---
  aceptaInversaCambioMercaderia Boolean @default(false)
  aceptaInversaSoloRetiro       Boolean @default(false)
  aceptaInversaDropOff          Boolean @default(false)

  // --- DEUDA 29: Performance — timeout por courier al cotizar ---
  timeoutCotizacionMs Int @default(7000)

  envios        Envio[]
  nomencladores Nomenclador[]
  encuestasNPS  EncuestaNPS[]
  metricasSLA   MetricaSLA[]
  slas          SlaCourier[]

  // --- DEUDA 29: Relaciones nuevas ---
  sucursales                    SucursalCourier[]
  tramos                        TramoEnvio[]
  latencias                     MetricaCourierLatencia[]
  depositosSucursalesPreferidas DepositoSucursalPreferida[]

  // DEUDA 29 Sub-fase 6.D.1: relación inversa con DepositoCourierConfig (par depósito × courier).
  depositoConfigsComoCourier DepositoCourierConfig[] @relation("ConfigCourierPrincipal")

  // DEUDA 29 Sub-fase 6.D (rectificación, 2026-05-19): inversa de Deposito.courierRecolectorId.
  // Identifica todos los depósitos donde este courier es el consolidador recolector.
  depositosDondeRecolecta Deposito[] @relation("DepositoRecolector")

  // DEUDA 32+37: servicios comerciales que este courier ofrece al cliente final.
  servicios ServicioCourier[]

  // DEUDA 107: cadena de intermediarios asociados a este courier como EJECUTOR
  // (courierId apunta acá). Se conserva por compatibilidad con el include actual
  // del motor de plata (cotizador.ts); Forma 2 (owner-axis) usa la relación de
  // abajo.
  intermediarios CourierIntermediario[]

  // FASE 2 pieza 1 (2026-07-30): back-relations del rol PROPIETARIO — este
  // courier es el DUEÑO de credenciales o de rows de markup. Sub-piece 4 lee por acá.
  credencialesComoPropietario     CredencialCourier[]     @relation("CredencialPropietario")
  intermediariosComoPropietario   CourierIntermediario[]  @relation("IntermediarioPropietario")

  // FASE 2 sub 1 (config variables tarifa, 2026-07-31): historial de SMO por
  // courier (SmoCourier). Migra la fuente de verdad desde los campos legacy
  // smoActivo / smoPrecioAlClienteConIva (que quedan como espejo hasta que el
  // motor pivotee a esta tabla en una sub-piece posterior).
  smos SmoCourier[]

  // DEUDA 19: audit log de cambios sensibles per-courier (credencialesJson, tipoCuenta, etc).
  auditoriasConfiguracion AuditoriaConfiguracion[]
}

// ==========================================
// DEUDA 107: CourierIntermediario
// Quién presta las credenciales de un courier (ej. Mocis presta Andreani).
// Modelo A solo — cuando usaCredencialesPropias=false. Vigencias permiten
// intercambiar el intermediario (Mocis→Intralog) sin perder histórico.
// ==========================================
model CourierIntermediario {
  id        Int     @id @default(autoincrement())

  // Legacy DEUDA 107: courier EJECUTOR (el courier cuyas credenciales se están
  // prestando; ej. Andreani cuando Mocis lo presta). Se conserva para no romper
  // el include actual en cotizador.ts (motor de plata en vivo). Sub-piece 4
  // podrá dejar de leer por este eje una vez que la lectura pivotee al OWNER.
  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  // FASE 2 pieza 1 (2026-07-30): Forma 2 — dueño de las credenciales que se
  // prestan (ej. Mocis en el par Mocis→Andreani). El markup del row se cascadeará
  // como el markup del DUEÑO. Reemplaza al viejo nombreIntermediario (String)
  // por una FK real a Courier; el string legacy nunca fue leído por lógica,
  // sólo escrito por el seed (recon 2026-07-30).
  propietarioCourierId  Int
  propietarioCourier    Courier @relation("IntermediarioPropietario", fields: [propietarioCourierId], references: [id], onDelete: Cascade)

  // Markup que el DUEÑO cobra por prestar credenciales, sobre la tarifa cruda del ejecutor.
  markupPorcentaje Float @default(0.0) // ej. 10.0 = +10%

  // Seguro fijo por etiqueta que factura el intermediario (ej. Mocis $90 vs Andreani $10).
  // Se guarda CON IVA (es lo que el intermediario nos factura).
  seguroFijoIntermediarioConIva Decimal @default(0) @db.Decimal(12, 2)

  // Si la tarifa/factura del intermediario ya incluye IVA (para no duplicarlo).
  tarifaIncluyeIvaIntermediario Boolean @default(true)

  // Vigencias: permiten cambiar de intermediario (Mocis→Intralog) sin perder histórico.
  activo        Boolean   @default(true)
  vigenciaDesde DateTime  @default(now())
  vigenciaHasta DateTime?

  notas String? // ej. "Andreani cobra $10+IVA de seguro; Mocis factura $90+IVA"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice legacy — todavía usado por cotizador.ts:279 include.
  @@index([courierId, activo])
  // FASE 2 pieza 1: Forma 2 — lookup por DUEÑO (el motor lo consumirá en sub-piece 4).
  @@index([propietarioCourierId, activo])
}

// ==========================================
// DEUDA 32+37: ServicioCourier
// Servicios comerciales que un courier ofrece al cliente final.
// El admin los activa/desactiva desde admin-couriers. Solo se pueden
// activar los que el adapter del courier declara soportar
// (capacidadTecnicaMapeada no-null). Ver docs/DISENO-DEUDA-32-37.md.
// ==========================================
model ServicioCourier {
  id        Int     @id @default(autoincrement())
  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  // Identificador estable del servicio (no se traduce). Ej: "entrega_domicilio_estandar".
  codigoServicio String
  // Agrupador para la UI: "entrega" | "logistica_inversa".
  grupo          String
  // Orden de aparicion en la UI.
  ordenVisual    Int    @default(0)

  // Switch del admin: el servicio esta ofrecido al cliente final o no.
  activo                  Boolean @default(false)
  // Mapeo a la capacidad tecnica del adapter. Ej: "andreani_dispatch_domicilio_estandar".
  // NULL = el adapter no soporta este servicio (switch bloqueado en UI).
  capacidadTecnicaMapeada String?

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@unique([courierId, codigoServicio])
  @@index([courierId, activo])
}

// ==========================================
// FASE 2 pieza 1: propiedad de credenciales.
// El TIPO de propietario de un CredencialCourier — quién es el dueño de las
// credenciales que la empresa usa para despachar con este courier.
//   CLIENTE  = Rama B: el cliente carga sus propias credenciales (equivalente a
//              usaCredencialesPropias=true). Solo aplica el markup Shipro.
//   SHIPRO   = Rama A: las credenciales son de Shipro. No hay markup de dueño
//              (sólo la cascada Shipro + SMO + Fee).
//   COURIER  = Rama A: las credenciales son de OTRO courier integrado (ej. Mocis
//              presta Andreani). El markup del dueño (CourierIntermediario) se
//              cascadeará ANTES del markup Shipro. Requiere propietarioCourierId.
// ==========================================
enum PropietarioTipo {
  CLIENTE
  SHIPRO
  COURIER
}

// ==========================================
// 1.5. CREDENCIALES COURIERS (El Cerebro)
// ==========================================
model CredencialCourier {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  nombreCourier String
  activo        Boolean @default(true)

  usaCredencialesPropias Boolean @default(true)
  credencialesJson       String?

  // FASE 2 pieza 1 (2026-07-30): propiedad de credenciales — dueño explícito.
  // Convive con `usaCredencialesPropias` (que sigue siendo el toggle primario
  // Rama A/B); estos campos son ADITIVOS y NULLABLE al nacer (sub-piece 3 hará
  // que la obligatoriedad se aplique en el pipeline de creación de envío).
  //
  //   propietarioTipo=CLIENTE  ↔ usaCredencialesPropias=true  (Rama B)
  //   propietarioTipo=SHIPRO   ↔ usaCredencialesPropias=false, sin markup dueño
  //   propietarioTipo=COURIER  ↔ usaCredencialesPropias=false, propietarioCourierId REQUERIDO
  //                              (el motor de plata en sub-piece 4 leerá el markup
  //                              del dueño desde CourierIntermediario keyed by owner)
  //
  // propietarioCourierId sólo tiene sentido cuando propietarioTipo=COURIER; en los
  // otros dos casos DEBE ser NULL. La coherencia se enforce en aplicación (schema
  // sólo declara la relación opcional).
  propietarioTipo       PropietarioTipo?
  propietarioCourierId  Int?
  propietarioCourier    Courier?         @relation("CredencialPropietario", fields: [propietarioCourierId], references: [id], onDelete: SetNull)

  // Tipo de cuenta para esta combinación cliente↔courier (DEUDA 16).
  // null = usar Empresa.modalidadPago como default.
  // PREPAGO: validar saldoActivo >= costo antes de despachar.
  // POSTPAGO: validar saldoActivo + limiteDescubierto >= costo.
  // Si no alcanza: envío queda en estado BLOQUEADO_SALDO sin tracking real.
  tipoCuenta String?

  // --- DEUDA 29 Sub-fase 6.D.6: campos legacy modoFirstMile y
  // courierRecolectorId eliminados. La modalidad de First-Mile se
  // resuelve ahora a nivel par (deposito x courier) via
  // DepositoCourierConfig.recogeViaConsolidador / dropOffCliente +
  // Deposito.courierRecolectorId. Ver decision #49.

  ofreceDomicilio Boolean @default(true)
  ofreceSucursal  Boolean @default(true)

  // --- REGLAS DE PRICING PARTICULAR ---
  // DEUDA 123 mov 3 (2026-08-03): campo tarifaIncluyeIva eliminado. La bandera
  // vive ahora en el adapter (ICourierIntegrator.tarifaApiIncluyeIva, movement 1
  // commit 88abb30) — es propiedad del adapter, no de la credencial. El motor
  // consume el flag desde motorCourier.tarifaApiIncluyeIva en cotización y en
  // el fallback de crear.ts (movement 2 commit 48d2067). La conciliación sigue
  // usando su propia bandera Excel-declared (tarifaExcelIncluyeIva) que es
  // independiente y no depende del adapter.
  ajusteTarifaPorcentaje Float     @default(0.0) // Markup en %
  markupFijo             Decimal   @default(0) @db.Decimal(12, 2) // Fee fijo por paquete (Ej: +$500)
  fechaCaducidadPromo    DateTime? // Fecha límite de esta condición comercial

  // DEUDA 73: el cliente elige si quiere el seguro del courier. Si true → se manda valorDeclarado
  // real al courier (calcula su seguro). Si false → se manda mínimo (seguro mínimo del courier).
  // Reemplaza semánticamente al viejo `requiereSeguro` (que queda obsoleto, se limpia en deuda aparte).
  quiereSeguroCourier         Boolean @default(false)
  // DEUDA 73: descuento/recargo que el CLIENTE aplica sobre la tarifa publicada a SU comprador.
  // CON SIGNO: negativo=subvención (regala plata al comprador), positivo=recargo. SIN tope (es su
  // estrategia comercial). Capa cliente→comprador, distinta del markup Shipro→cliente.
  descuentoClienteSobreTarifa Decimal @default(0) @db.Decimal(12, 2)

  ordenamientoDefault String @default("PRECIO_ASC")

  serviciosActivos String?

  // DEUDA 29: campos eliminados (tipoAlcance, provinciasCobertura, localidadesActivas).
  // Cobertura ahora se consulta al courier en cada cotización (trust the source of truth).

  ordenamientoDomicilio String @default("PRECIO_ASC")
  ordenamientoSucursal  String @default("PRECIO_ASC")

  // OBSOLETO (DEUDA 73): reemplazado por quiereSeguroCourier. Se elimina en una migración de limpieza aparte.
  requiereSeguro Boolean @default(false)
  slaPromedioHs  Int     @default(48)

  // Tarifa plana de rescate per-courier. Si null, cae al campo homónimo de Empresa.
  // Mismo patrón que slaPromedioHs: override per-courier del default de empresa.
  // DEUDA 132 Paso 5a (2026-08-25): campo LEGACY — reemplazado por
  // tarifaPlanaRespaldoCourier abajo. Ningún reader lo consume ya; drop en cleanup aparte.
  tarifaPlanaRespaldo Decimal? @db.Decimal(12, 2)

  // DEUDA 132 Paso 5a (2026-08-25): tarifa de rescate POR courier — reemplaza la
  // vieja Empresa.tarifaPlanaRespaldo. Se publica cuando el courier no puede cotizar
  // (fallback DEUDA 129) o cuando el e-commerce no manda datos (Paso 5c). Nullable:
  // un courier sin tarifa configurada NO emite fallback (no hay default mágico
  // per-empresa; skip explícito, más honesto que un placeholder de 1kg×10cm×etc).
  tarifaPlanaRespaldoCourier Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombreCourier])
  // FASE 2 pieza 1: lookup por dueño (Forma 2 — el motor pivotea por dueño en sub-piece 4).
  @@index([propietarioCourierId])
}

// ==========================================
// 2. MÓDULOS SATÉLITES (La Inteligencia)
// ==========================================

model Direccion {
  id          Int     @id @default(autoincrement())
  nombre      String?
  documento   String?
  telefono    String?
  email       String?
  cp          String
  calle       String?
  altura      String?
  piso        String?
  dpto        String?
  localidad   String?
  provincia   String?
  pais        String  @default("Argentina")
  observacion String?

  enviosOrigen  Envio[] @relation("EnvioOrigen")
  enviosDestino Envio[] @relation("EnvioDestino")
}

model OrdenExterna {
  id                     Int     @id @default(autoincrement())
  canal                  String?
  idTienda               String?
  ordenId                String?
  referencia             String?
  mercadolibreShipmentId String?

  envio Envio?
}

// ==========================================
// 2.3 FINANZAS DE ENVÍO (El Escudo Contable)
// ==========================================
// ============================================================================
// STEP 1 (dos-vías-liquidación): enums para el estado por track + el tipo
// de proforma. NO existían enums en el schema; se introducen ahora.
// EstadoLiquidacion.NO_APLICA solo aplica a la vía LOGISTICA de Rama B
// (Shipro nunca recibe factura del courier en Rama B, así que la vía
// logística no tiene sentido para esos envíos).
// ============================================================================
enum EstadoLiquidacion {
  PENDIENTE
  EN_PROCESO
  LIQUIDADO
  OBSERVADO
  ANULADO
  NO_APLICA
}

enum TipoLiquidacion {
  FEE
  LOGISTICA
}

model FinanzasEnvio {
  id Int @id @default(autoincrement())

  // 1. Lo que mostramos / cobramos
  precioMostrado          Decimal? @db.Decimal(12, 2) // Lo que el comprador vio en el checkout
  precioFactura           Decimal? @db.Decimal(12, 2) // Lo que Shipro le debita a la empresa
  porcentajePrecioFactura Float?
  valorDeclarado          Decimal? @db.Decimal(12, 2) // Seguro de la mercadería (Terceros)

  // 2. Auditoría del Courier (Escudo Tarifario)
  precioProveedor       Decimal? @db.Decimal(12, 2) // Costo cotizado al crear la etiqueta
  costoCourierEsperado  Decimal? @db.Decimal(12, 2) // NUEVO: Lo que DEBERÍA cobrar el courier según el aforo final
  costoCourierFacturado Decimal? @db.Decimal(12, 2) // NUEVO: Lo que REALMENTE vino en el Excel del courier
  estadoAuditoria       String   @default("PENDIENTE") // OK, DOBLE_COBRO, SOBREPRECIO_RECLAMAR
  facturaCourierRef     String? // NUEVO: Escudo anti-UPS (Ej: "FC-0001-9992")

  // 3. Auditoría de Peso Físico
  pesoCobrado Float? // Peso cotizado inicialmente (Ej: 1kg)
  pesoAforado Float? // Peso real facturado a fin de mes (Ej: 5kg)
  costoAforo  Decimal? @db.Decimal(12, 2) // Diferencia monetaria del desvío cobrada al cliente

  // 4. Auditoría de Ruteo Inteligente (Costo de Oportunidad)
  fugaFinanciera   Decimal? @default(0) @db.Decimal(12, 2) // Diferencia $ vs la mejor opción
  courierSugerido  String? // Quién era el más barato para esta modalidad
  servicioSugerido String? // Qué servicio era el más barato

  // 5. Desglose de pricing (DEUDA 73 + 107) — nullable: los envíos históricos no lo tienen.
  // La conciliación prefiere precioProveedorReal cuando existe; si no, cae a precioProveedor (legacy).
  tarifaCourierBase           Decimal? @db.Decimal(12, 2) // lo que devolvió la API cruda
  markupIntermediarioAplicado Decimal? @db.Decimal(12, 2) // el +% + fijo del intermediario (Modelo A)
  seguroAplicado              Decimal? @db.Decimal(12, 2) // el seguro que terminó en el precio
  descuentoClienteAplicado    Decimal? @db.Decimal(12, 2) // el descuento/recargo del cliente (con signo)
  precioProveedorReal         Decimal? @db.Decimal(12, 2) // costo real esperado = base + markup intermediario

  // 6. STEP 1 (dos-vías-liquidación) — congelamos la rama al alta y persistimos
  // el breakdown (fee neto / logística neta / IVA), para poder emitir dos proformas
  // (FEE y LOGISTICA) sin recomputar y sin depender de OperacionFee vigente al cierre.
  // Invariante (rows no-fallback): feeNetoFacturado + logisticaNetaFacturada + ivaFacturado == precioFactura.
  ramaCongelada              Boolean            @default(false) // true=Rama B (creds propias), false=Rama A. Snapshot de usaCredencialesPropias al alta.
  feeNetoFacturado           Decimal?           @db.Decimal(12, 2) // Fee Shipro NETO (sin IVA). NULL si Rama A cayó en fallback (breakdown irrecuperable).
  logisticaNetaFacturada     Decimal?           @db.Decimal(12, 2) // Cascada + SMO, NETO. Rama B = 0. NULL en fallback.
  ivaFacturado               Decimal?           @db.Decimal(12, 2) // IVA 21% sobre (feeNeto + logisticaNeta). NULL en fallback.
  estadoLiquidacionFee       EstadoLiquidacion  @default(PENDIENTE)
  estadoLiquidacionLogistica EstadoLiquidacion  @default(PENDIENTE) // Rama B → NO_APLICA. Fallback → OBSERVADO.
  liquidacionFeeId           Int?
  liquidacionFee             LiquidacionMensual? @relation("FinanzasLiqFee", fields: [liquidacionFeeId], references: [id])
  liquidacionLogisticaId     Int?
  liquidacionLogistica       LiquidacionMensual? @relation("FinanzasLiqLogistica", fields: [liquidacionLogisticaId], references: [id])
  periodoLogistica           String? // YYYY-MM declarado en conciliación (mes del período de la factura del courier). NULL hasta que llega la factura.
  logisticaDevuelta          Boolean            @default(false) // Se pone true en el sweep 6-meses (STEP 2+).
  fechaDevolucionLogistica   DateTime?

  envio Envio?

  @@index([estadoLiquidacionLogistica, logisticaDevuelta]) // 6-month sweep (STEP 2+)
  @@index([periodoLogistica]) // logistics proforma lookup
  @@index([facturaCourierRef]) // conciliación DOBLE_COBRO lookup
}

// ==========================================
// 2.5 EL EXTRACTO BANCARIO 
// ==========================================
model MovimientoFinanciero {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  tipo           String // Ej: "DEBITO_ENVIO", "CREDITO_RECARGA", "AJUSTE_AFORO"
  monto          Decimal @db.Decimal(12, 2) // Negativo (débito) o Positivo (crédito)
  saldoPosterior Decimal @db.Decimal(12, 2) // Foto del saldo después del movimiento

  referencia  String? // Ej: "Tracking #12345" o "Transf. MP #999"
  descripcion String? // Ej: "Ajuste por aforo de 1kg a 5kg"

  envioId Int? // Vinculación directa a un paquete (opcional)
  envio   Envio? @relation(fields: [envioId], references: [id])

  // PASO 2b (2026-07-27): FK a la corrida de conciliación que generó este
  // movimiento (débito prepago en real-time al importar la factura del courier,
  // o su reversión al hacer revertir). NULL para todo lo demás. Habilita al
  // revertir encontrar los débitos a compensar por corrida.
  conciliacionRunId Int?
  conciliacionRun   ConciliacionRun? @relation(fields: [conciliacionRunId], references: [id])

  fecha DateTime @default(now())

  // STEP 1: la wallet-page ordena por fecha desc y filtra por empresa.
  // El campo cronológico de este modelo es `fecha` (no `createdAt`).
  @@index([empresaId, fecha])

  // PASO 2b: lookup por corrida de conciliación (revertir busca los débitos a compensar).
  @@index([conciliacionRunId])

  // PASO 2b IDEMPOTENCY: máximo un movimiento por (corrida, envío, tipo). El tipo
  // entra en el trío UNIQUE para que el DÉBITO original y su CRÉDITO reverso puedan
  // coexistir bajo la misma (corrida, envío) — tienen distinto tipo, no colisionan.
  // NOTA POSTGRES: NULLs son DISTINTOS en índices únicos, así que los movimientos
  // con conciliacionRunId NULL (todos los DEBITO_ENVIO al alta, INGRESO_MANUAL,
  // AJUSTE_ADMIN) NO colisionan entre sí — el índice opera únicamente sobre filas
  // con la FK NOT NULL.
  @@unique([conciliacionRunId, envioId, tipo])
}

// ==========================================
// 2.6 LIQUIDACIÓN MENSUAL (El Cierre Fiscal)
// ==========================================
model LiquidacionMensual {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  periodo    String // STEP 1: YYYY-MM (validado por admin/liquidaciones). Formatos legacy (ej. "JULIO 2026") solo en rows viejas.
  montoTotal Decimal @db.Decimal(12, 2) // La suma de todos los envíos y aforos del mes
  estado     String  @default("EMITIDA") // EMITIDA, PAGADA, ANULADA (ANULADA la introduce PASO 2b; PAGADA la introducirá el flow de cobranza)

  // STEP 1: discriminador de proforma. Default LOGISTICA (compatibilidad con rows previas
  // — el comportamiento pre-STEP-1 era efectivamente una proforma combinada, más cercana
  // a la vía LOGISTICA porque su gate era pesoAforado != null).
  tipo TipoLiquidacion @default(LOGISTICA)

  excelProformaUrl String? // El link al Excel consolidado con el detalle
  facturaXubioUrl  String? // El link al PDF legal de la AFIP generado por Xubio
  // 2026-07-28: número de la factura de Xubio (ej. "A-0004-00001234"). Se
  // carga DESPUÉS de emitir la factura vía PATCH /api/admin/liquidaciones —
  // la LiquidacionMensual se crea antes de que exista la factura, así que
  // arranca en null. Permite matchear liquidado ↔ facturado.
  numeroFacturaExterna String?

  fechaCreacion DateTime @default(now())

  // STEP 1 (dos-vías-liquidación): las FKs desde envío vienen ahora por
  // FinanzasEnvio (finanzasFee / finanzasLogistica). La legacy `envios Envio[]`
  // fue dropeada junto con Envio.liquidacionId.
  finanzasFee       FinanzasEnvio[] @relation("FinanzasLiqFee")       // proformas tipo=FEE
  finanzasLogistica FinanzasEnvio[] @relation("FinanzasLiqLogistica") // proformas tipo=LOGISTICA

  // 2026-07-28: lookup por número de factura de Xubio (matching liquidado↔facturado).
  @@index([numeroFacturaExterna])
}

// ==========================================
// 3. EL CORAZÓN OPERATIVO (El Envío)
// ==========================================
model Envio {
  id Int @id @default(autoincrement())

  trackingNumber         String  @unique
  // DEUDA 29: trackingFirstMile eliminado. La info ahora vive en TramoEnvio.
  // Verificado pre-refactor: 0 envíos productivos referenciaban este campo.
  diasPrometidosCheckout Int?
  numeroOrden            String?

  // DEUDA 144 (Momento 3 labels) — puente 1:1 al fulfillment order de Tiendanube.
  // Nullable: sólo los envíos originados por el label callback de Tiendanube los tienen.
  // tiendanubeFulfillmentOrderId es además la base de idempotencia del callback (mismo
  // fulfillment order pedido 2 veces = mismo envío, no doble despacho + doble débito).
  tiendanubeFulfillmentOrderId String?
  tiendanubeStoreId            Int?

  // DEUDA 104 — order_id de Tiendanube (el system id de la orden, NO el numeroOrden de display).
  // Se rellena vía el webhook fulfillment_order/* (que trae order_id + fulfillment_id juntos), matcheando
  // por tiendanubeFulfillmentOrderId. Necesario para el tracking push (URL /orders/{order_id}/...) y el
  // matching confiable de los LGPD customers/*. Nullable: sólo los envíos Tiendanube que ya recibieron un
  // webhook fulfillment_order lo tienen.
  tiendanubeOrderId String?

  // DEUDA 128: clave de idempotencia por plugin. Enviada como header Idempotency-Key.
  // Scope per-empresa: @@unique([empresaId, idempotencyKey]) previene duplicados
  // dentro de la misma empresa. NULL = creado sin clave (dashboard manual, no plugin).
  idempotencyKey String?

  // DEUDA 29: cómo arrancó el envío.
  // - "recoleccion_courier": un courier (mismo o consolidador) retira del depósito.
  // - "drop_off_cliente": el cliente llevó el paquete a una sucursal del courier.
  tipoOrigen String @default("recoleccion_courier")

  etiquetaUrl String?

  pesoReal        Float
  // DEUDA 132 (2026-08-24): dimensiones del envío, gemelas de pesoReal. Nullable
  // porque un envío puede nacer sin ellas (queda BLOQUEADO_DATOS_PAQUETE en Paso 3).
  // Persistidas al crear y leídas al re-despachar, para que sobrevivan a un bloqueo.
  largoCm Float?
  anchoCm Float?
  altoCm  Float?
  pesoVolumetrico Float?
  pesoFacturado   Float?
  fragil          Boolean @default(false)

  tipo       String?
  modalidad  String  @default("Estándar")
  servicioId String?

  estadoActual String @default("IMPRESO")

  // STEP 1 (dos-vías-liquidación): la vía única legacy fue reemplazada por
  // FinanzasEnvio.estadoLiquidacionFee/estadoLiquidacionLogistica +
  // FinanzasEnvio.liquidacionFeeId/liquidacionLogisticaId. Los tres campos
  // viejos (estadoLiquidacion, liquidacionId, liquidacion) fueron dropeados.

  fechaImpresion     DateTime  @default(now())
  fechaColecta       DateTime? // Cuándo el courier hizo la recolección física
  fechaEntrega       DateTime? // Cuándo llegó a manos del cliente
  // F2 Bloque 1 (2026-06-09): timestamp del último rastreo del cron. Permite
  // priorización "oldest first" en el cron de rastreo (5,800 rastreos diarios
  // teóricos con 200 envíos cada 30 min, 8-22h ART). Si NULL, el envío nunca
  // fue rastreado y se prioriza primero.
  fechaUltimoRastreo DateTime?

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id])

  origenId Int?
  origen   Direccion? @relation("EnvioOrigen", fields: [origenId], references: [id])

  // DEUDA 4: referencia al Deposito que originó el envío. La Direccion en
  // origenId es un snapshot al momento de creación; depositoId apunta al
  // registro vivo (que el cliente puede haber editado después).
  // onDelete: Restrict — defense-in-depth contra borrado físico. El endpoint
  // DELETE hace soft delete (eliminado=true). La BD rechaza un DELETE accidental.
  depositoId Int?
  deposito   Deposito? @relation(fields: [depositoId], references: [id], onDelete: Restrict)

  destinoId Int?
  destino   Direccion? @relation("EnvioDestino", fields: [destinoId], references: [id])

  ordenExternaId Int?          @unique
  ordenExterna   OrdenExterna? @relation(fields: [ordenExternaId], references: [id])

  finanzasId Int?           @unique
  finanzas   FinanzasEnvio? @relation(fields: [finanzasId], references: [id])

  manifiestoId Int?
  manifiesto   Manifiesto? @relation(fields: [manifiestoId], references: [id])

  eventos     EventoTracking[]
  tickets     TicketSoporte[]
  movimientos MovimientoFinanciero[]
  encuestaNPS EncuestaNPS?

  // DEUDA 106 pieza 2 mov 2 (2026-08-04): token del comprador para corregir la
  // dirección de un envío RETENIDO. Se genera al nacer el envío si va a estado
  // RETENIDO (lib/envios/crear.ts, block de peaje), viaja en el mail al comprador
  // como /corregir/<tracking>?token=<token>, y validador se conecta en el
  // movimiento 4 (endpoints buscar + corregir aceptan token OR session).
  // Vencimiento: 48h desde generación (design lock Nacho).
  // @unique nullable — Postgres permite múltiples NULL bajo una unique constraint
  // (cada NULL cuenta como distinto), así que sólo los envíos con token tienen
  // valor y el índice sirve para lookup O(1) al validar.
  correccionToken       String?   @unique
  correccionTokenExpira DateTime?

  // DEUDA 29: cadena de tramos (recolección, entrega, ciclo_completo).
  // Cada tramo tiene su propio courier responsable y trackingExterno.
  tramos TramoEnvio[]

  // DEUDA 139 P3: multi-bulto (1 fila por bulto del envío). Predicción del motor
  // de empaquetado + resultado del courier al despachar + estado de viaje + peso
  // aforado post-facturación. Nace vacío en envíos legacy 1-bulto.
  bultos EnvioBulto[]

  // DEUDA 144 (Momento 3 labels) — etiquetas emitidas en Tiendanube para este envío
  // (una fulfillment order admite hasta 20; típicamente 1 provisoria + 1 real).
  etiquetasTiendanube EtiquetaTiendanube[]

  // STEP 1: la app usa fechaImpresion como "created at" del envío (no hay createdAt).
  // Este índice sirve al 6-month sweep + al wallet-por-empresa por fecha.
  @@index([empresaId, fechaImpresion])

  // DEUDA 144: lookup del envío por fulfillment order de Tiendanube (idempotencia del
  // label callback + cancel/re-emit al destrabar). Nullable → índice sirve sólo cuando
  // hay valor; el resto queda irrelevante.
  @@index([tiendanubeFulfillmentOrderId])

  // DEUDA 128: idempotencia per-empresa. Postgres permite múltiples NULL bajo la
  // unique constraint (cada NULL cuenta como distinto), así que envíos sin clave
  // no colisionan entre sí; sólo empresas que mandan clave la ven enforced.
  @@unique([empresaId, idempotencyKey])
}

// ==========================================
// 4. TRAZABILIDAD (Historial de Estados)
// ==========================================
model EventoTracking {
  id                  Int      @id @default(autoincrement())
  estado              String
  // estadoCrudoOriginal: estado raw del courier ANTES del mapeo via Nomenclador.
  // Nullable porque eventos previos a esta migracion (Torre de Control Metrica 1.1,
  // 2026-06-04) no lo tienen. Eventos nuevos lo deben poblar siempre via cron rastreo.
  // Fuente para metrica "Resolver Nomenclador" — calcular frecuencia ponderada.
  estadoCrudoOriginal String?
  observacion         String?
  fecha               DateTime @default(now())

  // DEUDA 104 (Movimiento 2/3) — timestamp de cuándo este evento se empujó al timeline de Tiendanube
  // (POST tracking-events). NULL = no se pusheó todavía (o el envío no es de Tiendanube, o el push falló y
  // espera el barrido de reintento del Movimiento 3). Idempotencia: el push sólo corre si esto es NULL.
  sincronizadoTiendanubeEn DateTime?

  envioId Int
  envio   Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. CONFIGURACIÓN Y REGLAS DE NEGOCIO
// ==========================================
model Nomenclador {
  id           Int     @id @default(autoincrement())
  estadoCrudo  String
  codigoApi    String?
  estadoShipro String?

  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id])

  @@unique([courierId, estadoCrudo])
}

// ==========================================
// 6. MESA DE AYUDA (Atención al Cliente)
// ==========================================
model TicketSoporte {
  id          Int     @id @default(autoincrement())
  motivo      String
  estado      String  @default("ABIERTO")
  observacion String?

  fechaCreacion DateTime  @default(now())
  fechaCierre   DateTime?

  envioId Int
  envio   Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  auditorias AuditoriaSoporte[]
}

// ==========================================
// 7. AUDITORÍA Y TRAZABILIDAD (CRM)
// ==========================================
model AuditoriaSoporte {
  id      Int      @id @default(autoincrement())
  accion  String
  detalle String?
  fecha   DateTime @default(now())

  usuarioEmail String?

  ticketId Int
  ticket   TicketSoporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ==========================================
// DEUDA 19 — AUDITORÍA DE CONFIGURACIÓN
// Audit log de cambios sensibles en credenciales y configuración financiera.
// 12 campos auditados (CRÍTICOS + ALTOS): credencialesJson, tipoCuenta,
// usaCredencialesPropias, activo, modalidadPago, limiteDescubierto, apiKey,
// apiKeyActiva, modeloAHabilitado, ajusteTarifaPorcentaje, markupFijo,
// requiereSeguro.
// Email + IP origen capturados via headers inyectados por proxy.ts (x-usuario-email
// + x-ip-origen). Motivo obligatorio para cambios sensibles (validacion backend).
// ==========================================
model AuditoriaConfiguracion {
  id    Int      @id @default(autoincrement())
  fecha DateTime @default(now())

  // Quien hizo el cambio
  usuarioEmail String?
  rolUsuario   String?
  ipOrigen     String?

  // A quien afecta
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  // Que cambio
  campo         String // "tipoCuenta", "modalidadPago", "apiKey", "credencialesJson", etc.
  valorAnterior String?
  valorNuevo    String?

  // Por que (obligatorio para cambios sensibles)
  motivo String?

  @@index([empresaId, fecha])
  @@index([courierId, fecha])
  @@index([campo, fecha])
}

// ==========================================
// 8. AUDITORÍA DE CHECKOUTS (El Peaje)
// ==========================================
model AuditoriaCheckout {
  id             Int     @id @default(autoincrement())
  tienda         String
  comprador      String
  email          String
  telefono       String?
  direccionCruda String

  score     Int     @default(0)
  problemas String?

  calle       String?
  altura      String?
  piso        String?
  dpto        String?
  cp          String?
  localidad   String?
  provincia   String?
  entrecalles String?

  resuelto      Boolean  @default(false)
  fechaCreacion DateTime @default(now())
}

// ==========================================
// 9. DATOS MAESTROS (Geografía Argentina)
// ==========================================
model Provincia {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  localidades Localidad[]
}

model Localidad {
  id     Int    @id @default(autoincrement())
  nombre String

  provinciaId Int
  provincia   Provincia @relation(fields: [provinciaId], references: [id], onDelete: Cascade)

  codigos CodigoPostal[]
}

model CodigoPostal {
  id     Int    @id @default(autoincrement())
  codigo String @unique

  localidades Localidad[]
}

// ==========================================
// 10. ARMADO Y COLECTAS (Historial)
// ==========================================
model Manifiesto {
  id                Int      @id @default(autoincrement())
  numeroCorrelativo Int
  fechaCreacion     DateTime @default(now())
  courier           String
  cantidadPaquetes  Int
  pdfUrl            String?

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  envios Envio[]
}

// ==========================================
// 11. EXPERIENCIA DE CLIENTE (NPS Transaccional)
// ==========================================
model EncuestaNPS {
  id Int @id @default(autoincrement())

  // Q1: NPS Principal (0-10)
  score     Int
  categoria String // PROMOTOR, PASIVO, DETRACTOR (Calculado automáticamente)

  // Q2: Motivo Principal
  comentario String?

  // Q3: Experiencia de Entrega
  experienciaEntrega String? // Ej: "A tiempo", "Demorado", "Paquete dañado"

  // Q4: Satisfacción Producto
  satisfaccionProducto Int? // Escala 1-5

  // Q5: Intención de Recompra
  probabilidadRecompra Int? // Escala 0-10

  // Q6: Sugerencia de Mejora
  sugerenciaMejora String?

  // --- DATOS DE CONTEXTO ---
  slaCumplido Boolean? // Cruzamos si el correo cumplió el SLA vs lo que el cliente sintió
  cpDestino   String?
  provincia   String?
  modalidad   String?

  envioId Int   @unique
  envio   Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id])

  fechaVoto DateTime @default(now())
}

// ==========================================
// VOZ DE LA EMPRESA CLIENTE — Metrica 1.3 (DEUDA 39, 2026-06-11)
// NPS Cliente Empresa: gerente/operador del e-commerce evalua
// a Shipro como plataforma. Cadencia trimestral.
// ==========================================
model EncuestaNPSEmpresa {
  id Int @id @default(autoincrement())

  // Q1: NPS Principal (0-10) - "Recomendarias Shipro a otra empresa?"
  // Nullable: el cron crea placeholder con tokenVoto pero score/categoria
  // se completan cuando el usuario vota desde el form.
  score     Int?
  categoria String? // PROMOTOR (9-10), PASIVO (7-8), DETRACTOR (0-6)

  // Q2: Satisfaccion general con la plataforma (escala 1-5)
  satisfaccionPlataforma Int?

  // Q3: Calidad del soporte humano (escala 1-5, NULL si no tuvo contacto)
  calidadSoporte Int?

  // Q4: Lo que mas le gusta (texto abierto opcional)
  fortaleza String?

  // Q5: Lo que mejoraria (texto abierto opcional)
  sugerencia String?

  // --- CONTEXTO TEMPORAL ---
  periodo    String // "2026-Q2", "2026-Q3" (cadencia trimestral, decision director)
  fechaEnvio DateTime // cuando se disparo el email
  fechaVoto  DateTime @default(now())

  // --- FKs ---
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Token unico generado al disparar el email. Sin expiracion (decision director 2026-06-11).
  // Una vez usado, el endpoint /api/nps-empresa rechaza nuevos intentos (no permite re-voto).
  tokenVoto String @unique

  // Un usuario solo puede votar una vez por periodo trimestral.
  @@unique([usuarioId, periodo])
  @@index([empresaId, periodo])
  @@index([periodo])
}

// ==========================================
// 12. MOTOR DE RUTEO INTELIGENTE (Reglas Globales)
// ==========================================
model ReglaRuteo {
  id Int @id @default(autoincrement())

  // ---> AGREGAMOS ESTO PARA QUE CADA CLIENTE TENGA SUS REGLAS <---
  empresaId Int? // Si es NULL, es una plantilla global de Shipro
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

