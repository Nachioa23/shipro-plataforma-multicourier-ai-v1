// ==========================================
// 14. DEUDA 29 — ARQUITECTURA MULTICOURIER
// Ver docs/ARQUITECTURA-MULTICOURIER.md
// ==========================================

// Sucursales / puntos de los couriers (sucursal_propia, punto_red, locker).
// Tabla única para todos los couriers; columnas explícitas en lo que se usa para
// lógica (filtros, índices), JSON solo para datos de display.
model SucursalCourier {
  id Int @id @default(autoincrement())

  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id])

  // Identidad
  idExterno String // ID que el courier usa en su API
  codigo    String? // Código corto humano (ej. "SFN", "CNQ")
  nombre    String // Nombre legible (ej. "SANTA FE (CENTRO)")
  tipo      String  @default("sucursal_propia")
  // Valores: "sucursal_propia" | "punto_red" | "locker"

  // Dirección
  direccionCalle  String?
  direccionAltura String?
  direccionPiso   String?
  direccionDpto   String?
  codigoPostal    String
  localidad       String
  provincia       String
  pais            String  @default("Argentina")

  // Geolocalización (crítico para búsqueda de cercanía con Haversine)
  latitud  Float?
  longitud Float?

  // Capacidades operativas (columnas indexables, NO JSON)
  aceptaAdmision        Boolean @default(false)
  aceptaEntrega         Boolean @default(false)
  aceptaDevolucion      Boolean @default(false)
  aceptaB2B             Boolean @default(false)
  aceptaB2C             Boolean @default(true)
  tieneBuzonInteligente Boolean @default(false)

  // Atención
  horariosJson            String? // JSON estructurado con horarios por día
  telefono                String?
  email                   String?
  seHaceAtencionAlCliente Boolean @default(false)

  // Estado y auditoría
  activa                  Boolean   @default(true)
  eliminada               Boolean   @default(false) // Soft delete
  fechaUltimaConfirmacion DateTime? // Última sincronización

  // Datos no-lógicos (display, descripciones largas)
  metadatosJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tramosOrigen        TramoEnvio[]                @relation("TramoSucursalOrigen")
  tramosDestino       TramoEnvio[]                @relation("TramoSucursalDestino")
  depositosPreferidos DepositoSucursalPreferida[]
  codigosPostales     SucursalCourierCp[]

  @@unique([courierId, idExterno])
  @@index([courierId])
  @@index([latitud, longitud])
  @@index([courierId, codigoPostal])
}

// Sucursal preferida por depósito × courier. La plataforma sugiere con Haversine,
// el cliente confirma con un click ("el usuario manda" — Escenario 3 DEUDA 4).
model DepositoSucursalPreferida {
  id Int @id @default(autoincrement())

  depositoId Int
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id])

  sucursalCourierId Int
  sucursal          SucursalCourier @relation(fields: [sucursalCourierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([depositoId, courierId])
  @@index([courierId])
}

// DEUDA 29 Sub-fase 6.D (rectificación, 2026-05-19): configuración del cliente por par
// (depósito × courier). El modo de First-Mile NO se guarda aquí — es deducido por el
// sistema según cobertura del CP del depósito + flag dropOffCliente del par + presencia
// de Deposito.courierRecolectorId. Ver decisión #49 en docs/ARQUITECTURA-MULTICOURIER.md.
//
// Reemplaza el modelo anterior (commit 6.D.1) que tenía modoFirstMile + courierRecolectorId
// como atributos del par. Esos campos eran incorrectos conceptualmente:
// - modoFirstMile: pasaba a ser deducido (no configurado)
// - courierRecolectorId: pasaba a Deposito (1 sólo recolector por depósito)
//
// Lo único que el cliente decide explícitamente por par son 2 booleans:
model DepositoCourierConfig {
  id Int @id @default(autoincrement())

  depositoId Int
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  courierId Int
  courier   Courier @relation("ConfigCourierPrincipal", fields: [courierId], references: [id])

  // Si true, el cliente lleva físicamente sus paquetes a una sucursal del courier.
  // Fuerza modo "drop_off_cliente" para ese par. El sistema NO auto-asigna sucursal;
  // el cliente elige manualmente entre sucursales del courier cercanas a su depósito.
  dropOffCliente Boolean @default(false)

  // Si true, el courier recoge en el depósito del consolidador (no en el depósito del
  // cliente). Requiere que Deposito.courierRecolectorId esté seteado Y que el courier
  // cubra el CP del consolidador. Fuerza modo "consolidador" para ese par. Si false,
  // el courier recoge en el CP del depósito del cliente (modo "mismo_courier" por defecto).
  recogeViaConsolidador Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([depositoId, courierId])
  @@index([courierId])
}

// Tramos de la cadena logística de un envío.
// Cada tramo tiene su propio courier y trackingExterno. N tramos desde el inicio.
model TramoEnvio {
  id Int @id @default(autoincrement())

  envioId Int
  envio   Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  orden Int // 1, 2, 3... Secuencia cronológica.

  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id])

  tipo String
  // Valores: "recoleccion" | "entrega" | "ciclo_completo"

  trackingExterno String? // Tracking propio del courier para este tramo.

  estadoActual String @default("PENDIENTE")
  // Estado homogeneizado por Nomenclador (lenguaje Shipro).

  estadoCrudoUltimo String? // Último estado raw del courier, para auditoría.

  sucursalOrigenId Int?
  sucursalOrigen   SucursalCourier? @relation("TramoSucursalOrigen", fields: [sucursalOrigenId], references: [id])

  sucursalDestinoId Int?
  sucursalDestino   SucursalCourier? @relation("TramoSucursalDestino", fields: [sucursalDestinoId], references: [id])

  fechaCreacion DateTime  @default(now())
  fechaInicio   DateTime? // Cuando el courier tomó posesión (primer evento real).
  fechaFin      DateTime? // Cuando el tramo se cerró.

  metadatosJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([envioId, orden])
  @@index([envioId])
  @@index([trackingExterno])
  @@index([estadoActual])
}

// ==========================================
// DEUDA 139 P3 — EnvioBulto (multi-bulto analítico)
// ==========================================
// 1 fila por bulto de un Envio. Fuente de verdad de la granularidad multi-bulto:
// predicción del motor de empaquetado (peso/dims/valorDeclarado), resultado del
// courier al despachar (trackingExterno + etiquetaUrl + numeroBulto + totalizador),
// estado de viaje por-bulto (cada bulto trackea por separado), y peso aforado del
// courier post-facturación (métrica volumetría predicho vs facturado).
// Envíos legacy 1-bulto: la tabla nace vacía; se puebla cuando fase 1b/2 conecta
// el motor de empaquetado y el despacho multi-bulto real.
model EnvioBulto {
  id Int @id @default(autoincrement())

  envioId Int
  envio   Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  orden Int // Posición del bulto en el pedido: 1, 2, 3...

  // Predicción del motor de empaquetado (lo que Shipro calculó)
  pesoKg         Float
  largoCm        Float?
  anchoCm        Float?
  altoCm         Float?
  valorDeclarado Decimal? @db.Decimal(12, 2)

  // Resultado del courier al despachar (nace vacío, se llena al despachar)
  trackingExterno String?
  etiquetaUrl     String?
  numeroBulto     String? // id del courier para el bulto (ej. Andreani numeroDeBulto)
  totalizador     String? // ej. "1/3" (Andreani)

  // Estado de viaje del bulto (cada bulto trackea por separado)
  estadoActual      String  @default("PENDIENTE")
  estadoCrudoUltimo String?

  // Métrica de volumetría (nace vacío, se llena post-facturación)
  pesoAforadoCourier Float?

  fechaCreacion DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([envioId, orden])
  @@index([envioId])
  @@index([trackingExterno])
  @@index([estadoActual])
}

// Snapshot de cada cotización presentada al comprador. Propósito: analytics y
// tracking de conversión. NO se usa para validar precios al cierre de venta
// (en logística la cotización es estimación referencial, no contractual).
model CotizacionSnapshot {
  id                   Int      @id @default(autoincrement())
  empresaId            Int
  depositoOrigenId     Int
  destinoSnapshotJson  String
  paqueteSnapshotJson  String
  opcionesSnapshotJson String
  usadaEnEnvioId       Int?
  createdAt            DateTime @default(now())
}

// Métrica de latencia por llamada a courier. Para detectar degradación de servicio.
model MetricaCourierLatencia {
  id         Int      @id @default(autoincrement())
  courierId  Int
  courier    Courier  @relation(fields: [courierId], references: [id])
  operacion  String // "cotizar" | "despachar" | "tracking" | "etiqueta"
  latenciaMs Int
  status     String // "success" | "timeout" | "error"
  envioId    Int?
  createdAt  DateTime @default(now())

  @@index([courierId, operacion])
  @@index([createdAt])
}

// Histórico de cotizaciones para fallback cuando TODOS los couriers fallan.
// Se busca promedio de los últimos 30 días para combinación origen-destino-peso.
// Limpieza periódica de registros > 30 días.
model HistoricoCotizaciones {
  id        Int      @id @default(autoincrement())
  courierId Int
  cpOrigen  String
  cpDestino String
  pesoKg    Float
  precio    Decimal  @db.Decimal(12, 2)
  // DEUDA 10 (D-10-PRICE-STORE): precio CRUDO del courier (costoSecoCourier),
  // sin markup ni IVA. El markup del cliente se re-aplica al leer en el fallback.
  servicio  String? // texto crudo del courier ("Estándar", "Same Day"). Para lectura humana, NO criterio de busqueda.
  // DEUDA 10 (D-10-HIST-SHAPE): dimension domicilio/sucursal, que servicio NO captura.
  // Vocabulario controlado: "domicilio" | "sucursal". El cotizador lo conoce al insertar.
  modalidad String?
  createdAt DateTime @default(now())

  // DEUDA 10 Paso 2 (D-10-WRITE-VOLUME-OVERWRITE): unicidad por trayecto+peso+modalidad.
  // Habilita upsert: una sola fila por combinacion, pisada con el ultimo precio conocido.
  // El @@unique cubre el lookup del fallback, asi que el index compuesto previo es redundante y se elimina.
  @@unique([courierId, cpOrigen, cpDestino, pesoKg, modalidad])
  @@index([createdAt])
}

// DEUDA 10 (D-10-5, B-minima): fee por operacion que Shipro cobra a clientes
// Modelo B cuando ejecuta una operacion (despacho), exitoso o no. NO es el costo
// del envio (ese lo cobra el courier directo al cliente Modelo B).
// - tipo: "FIJO" (monto en $) | "PORCENTAJE" (% sobre tarifa courier). Default FIJO.
// - valor: el numero (pesos si FIJO, % si PORCENTAJE). Float -> Decimal en DEUDA 66.
// - vigenteDesde/Hasta: soporta descuentos promocionales temporales (Hasta=null = indefinido).
// - El "fee base" estandar de Shipro vive como constante en codigo; si la empresa
//   no tiene fila activa aca, se usa el base. El motor de actualizacion masiva es DEUDA 72.
model OperacionFee {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  tipo  String  @default("FIJO") // "FIJO" | "PORCENTAJE"
  valor Decimal @db.Decimal(12, 2)

  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime? // null = indefinido
  activo       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, activo])
}

// CPs atendidos por cada sucursal de courier (1:N desde SucursalCourier).
// Poblada por scripts/sincronizar-sucursales-andreani.ts a partir del
// campo codigosPostalesAtendidos del endpoint público /v2/sucursales.
// Permite resolver "qué sucursales atienden el CP X" sin parsear JSON.
model SucursalCourierCp {
  id                Int             @id @default(autoincrement())
  sucursalCourierId Int
  sucursal          SucursalCourier @relation(fields: [sucursalCourierId], references: [id], onDelete: Cascade)
  codigoPostal      String
  createdAt         DateTime        @default(now())

  @@unique([sucursalCourierId, codigoPostal])
  @@index([sucursalCourierId])
  @@index([codigoPostal])
}

// =============================================================================
// DEUDA 32+37 (Fase J): Registro de cotizaciones con cobertura vacia.
// =============================================================================
// Cada fila representa una cotizacion (POST /api/cotizar) donde la respuesta
// fue cero couriers (ni domicilio ni sucursal). Sirve para auditar la red
// logistica: que CPs nos piden y no podemos cotizar, con que frecuencia, para
// que empresas. Input para decisiones de integracion futura (ej: integrar OCA
// si vemos muchos CPs no cubiertos).
//
// El insert lo hace el cotizador (lib/cotizador.ts) cuando detecta vacio total.
// La consulta es para auditoria interna; no hay UI hoy (deuda futura).
// =============================================================================
model RegistroCoberturaVacia {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  cpDestino String
  pesoKg    Float
  largoCm   Float?
  anchoCm   Float?
  altoCm    Float?
  origen    String? // contexto: "dashboard" / "api" / etc.
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  @@index([fecha])
  @@index([cpDestino])
}

// =============================================================================
// ConciliacionRun — bitácora + snapshot para UNDO de una corrida de conciliación
// =============================================================================
// Cada POST /api/conciliacion crea una fila con:
//  - la referencia de factura del courier
//  - el ivaDeclarado por el usuario ("SIN_IVA" o "CON_IVA") — Nacho decidió que
//    la convención IVA del Excel NO se asume, la declara el usuario al subir
//  - el snapshot de los valores PREVIOS de FinanzasEnvio para cada envío tocado,
//    para poder revertir. La reversión (POST /api/conciliacion/revertir) restaura
//    los valores y marca revertida=true. Se bloquea la reversión si algún envío
//    del snapshot ya está en LiquidacionMensual (el mes ya cerró; hay que corregir
//    con ajuste, no con reversión).
// =============================================================================
model ConciliacionRun {
  id                     Int       @id @default(autoincrement())
  referenciaFactura      String
  ivaDeclarado           String // "SIN_IVA" | "CON_IVA"
  // STEP 1 (dos-vías-liquidación): período YYYY-MM al que corresponde la
  // factura del courier (no la fecha de importación). Se propaga a
  // FinanzasEnvio.periodoLogistica para agrupar la proforma LOGISTICA.
  // Nullable para retro-compatibilidad con ConciliacionRun previos.
  periodoFacturaCourier  String?
  cantidadEnvios         Int
  usuarioEmail           String?
  snapshot               Json // [{ finanzasEnvioId, prior: { pesoAforado, costoCourierEsperado, costoCourierFacturado, estadoAuditoria, facturaCourierRef, costoAforo, periodoLogistica, estadoLiquidacionLogistica } }]
  revertida              Boolean   @default(false)
  fechaReversion         DateTime?
  createdAt              DateTime  @default(now())

  // PASO 2b: los débitos prepago que crea la conciliación (y los CREDITO_REVERSO
  // que crea revertir) se atan acá para poder deshacer el dinero cuando la
  // corrida se revierte.
  movimientos MovimientoFinanciero[]

  @@index([referenciaFactura])
  @@index([createdAt])
}

// =============================================================================
// FASE 2 sub 1 (2026-07-31) — CONFIG VARIABLES DE TARIFA (schema aditivo).
// Ver docs/DISENO-MODELO-DATOS-CONFIG-VARIABLES.md.
// Tres tablas nuevas: MarkupShiproVigencia (global), SmoCourier (por courier),
// AjusteMasivoFee (evento auditable). Nada las lee todavía para pricing — el
// motor se conecta en una sub-piece posterior (paso 5 del §7 del diseño).
// Las dos primeras mirroreean el patrón de vigencias de CourierIntermediario;
// la tercera mirroreea el patrón de evento auditable de ConciliacionRun.
//
// Nota nomenclatura (DEUDA 114): estas tablas usan vigenciaDesde/vigenciaHasta.
// OperacionFee ya tiene vigencias con la ortografía legacy vigenteDesde/Hasta;
// unificar como higiene aparte.
// =============================================================================

/// Markup Shipro GLOBAL con vigencias. UNA sola fila activa a nivel plataforma
/// (no hay FK: es global). CredencialCourier.ajusteTarifaPorcentaje se mantiene
/// como gancho de OVERRIDE por empresa (empty/null = hereda este global).
/// Valor NETO en porcentaje (e.g. 10.0000 = +10%).
model MarkupShiproVigencia {
  id              Int     @id @default(autoincrement())
  valorPorcentaje Decimal @db.Decimal(12, 4)

  activo        Boolean   @default(true)
  vigenciaDesde DateTime  @default(now())
  vigenciaHasta DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

/// SMO (Seguro Mínimo de Shipro) por courier con vigencias. Espejo del patrón
/// de CourierIntermediario. Migra la fuente de verdad desde los campos legacy
/// Courier.smoActivo / Courier.smoPrecioAlClienteConIva (que quedan como
/// espejo hasta que el motor pivotee acá). valorNeto = SIN IVA.
model SmoCourier {
  id        Int     @id @default(autoincrement())
  courierId Int
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  valorNeto Decimal @db.Decimal(12, 2)

  activo        Boolean   @default(true)
  vigenciaDesde DateTime  @default(now())
  vigenciaHasta DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId, activo])
}

/// Registro auditable de ajustes masivos porcentuales del Fee sobre la cartera
/// de OperacionFee. Es un EVENTO, no un valor versionado: cada corrida deja un
/// row con quién, cuánto y cuántas empresas afectó. Estilo ConciliacionRun.
/// porcentaje: NETO (e.g. 10.0000 = +10%).
model AjusteMasivoFee {
  id                        Int      @id @default(autoincrement())
  porcentaje                Decimal  @db.Decimal(12, 4)
  fechaAplicacion           DateTime @default(now())
  aplicadoPorId             Int?
  aplicadoPor               Usuario? @relation(fields: [aplicadoPorId], references: [id], onDelete: SetNull)
  cantidadEmpresasAfectadas Int
  notas                     String?

  createdAt DateTime @default(now())

  @@index([fechaAplicacion])
  @@index([aplicadoPorId])
}

// =============================================================================
// DEUDA 144 — TiendaTiendanube: vinculación store↔empresa + credencial OAuth
// =============================================================================
// Registra cada tienda de Tiendanube conectada a una empresa Shipro. Prerequisito
// bloqueante del rates callback (POST /api/tiendanube/rates lookup storeId→empresaId)
// y consumida también por el flujo OAuth de instalación (Momento 1) y el frente de
// etiquetas/tracking (Momento 3).
//
// Reinstalación: UPDATE existente por storeId (NO nueva fila, NO nuevo shippingCarrierId)
// — regla Minimal de la checklist Poggi (1 carrier por app).
//
// El token de vinculación (link de instalación, un solo uso, expira) NO vive acá — es del
// flujo OAuth/Momento 1 y se agrega cuando se construya ese endpoint. Esta tabla representa
// la tienda YA VINCULADA post-OAuth.
model TiendaTiendanube {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // storeId de Tiendanube. @unique: un storeId pertenece a UNA sola empresa.
  // Una empresa puede tener varias tiendas (raro pero permitido): Empresa 1—N TiendaTiendanube.
  storeId Int @unique

  // accessToken OAuth permanente. Nace NULL (el flujo OAuth/Momento 1 aún no existe; se llena
  // ahí). Cuando se construya el OAuth, se guarda ENCRIPTADO — la utilidad de encriptación
  // reversible NO existe hoy (deuda a registrar); NUNCA se persiste en texto plano.
  accessToken String?

  // ID del carrier registrado en la tienda (1 por app, checklist Poggi). Se llena tras
  // POST /shipping_carriers. Nullable hasta que se registre.
  shippingCarrierId String?

  // Datos de la tienda traídos de GET /store (DEUDA 144). Nullable: se llenan best-effort al
  // instalar (post-OAuth); si la llamada falla, la tienda igual queda vinculada. `nombre` es el
  // nombre en español (multi-idioma en Tiendanube); `dominio` es el original_domain de la tienda.
  nombre  String?
  dominio String?

  // Lifecycle: "instalada" | "desinstalada" | "suspendida". Los webhooks app/uninstalled,
  // app/suspended, app/resumed lo actualizan. String (consistente con el estilo del schema).
  estado String @default("instalada")

  instaladaEn    DateTime  @default(now())
  desinstaladaEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // DEUDA 144 (Momento 3 labels) — etiquetas emitidas para esta tienda.
  etiquetas EtiquetaTiendanube[]

  @@index([empresaId])
  @@index([estado])
}

// =============================================================================
// DEUDA 144 (Momento 3 labels) — ciclo de vida de CADA etiqueta emitida en Tiendanube
// =============================================================================
// Un fulfillment order admite hasta 20 etiquetas (contrato Tiendanube): típicamente una
// provisoria genérica de Shipro (esProvisoria=true) + luego la real del courier
// (esProvisoria=false) tras destrabar el bloqueo. Esta tabla registra todas, con su
// estado del ciclo Tiendanube (STARTED→IN_PROGRESS→READY_TO_USE→...→CANCELED).
//
// MOLDE PARA OTRAS PLATAFORMAS: cuando se integre Shopify/otro e-commerce, replicar esta
// estructura como EtiquetaShopify/etc. (patrón por-plataforma, decisión de arquitectura Nacho).
model EtiquetaTiendanube {
  id Int @id @default(autoincrement())

  envioId Int
  envio   Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  tiendaTiendanubeId Int
  tienda             TiendaTiendanube @relation(fields: [tiendaTiendanubeId], references: [id], onDelete: Cascade)

  // id de la etiqueta que emite Tiendanube (pivot para PATCH cancelar/actualizar).
  labelId String @unique

  // id del fulfillment order al que pertenece (repetido cuando hay varias etiquetas).
  fulfillmentOrderId String

  // Ciclo Tiendanube: STARTED | IN_PROGRESS | READY_TO_DOWNLOAD | READY_TO_USE |
  // DOWNLOADED | CANCELED | SUSPENDED | FAILED. String (consistente con el estilo del schema).
  estado String @default("STARTED")

  // true = etiqueta genérica provisoria de Shipro (placeholder, no imprimible al courier).
  // false = etiqueta real del courier (definitiva). Distingue cuál cancelar al reemplazar.
  esProvisoria Boolean @default(false)

  // URL del PDF que servimos como download_url_from_app (nullable hasta generarlo).
  documentoUrl String?

  // Token opaco para el endpoint de descarga público (Tiendanube baja el PDF sin sesión).
  // @unique nullable — Postgres permite múltiples NULL bajo unique (cada NULL distinto), así
  // que sólo las etiquetas con token tienen valor y el índice sirve para lookup O(1) al validar.
  // Sin expiración por tiempo (decisión Nacho): la URL vive hasta que la etiqueta se cancele o
  // Tiendanube confirme READY_TO_USE (webhook, pieza posterior). El single-use NO se controla acá
  // (Tiendanube guarda el PDF en su S3 y reimprime desde ahí; esa regla vive en la NPMS).
  downloadToken String? @unique

  // tracking asociado a esta etiqueta (SHP-* si provisoria; real del courier si definitiva).
  trackingAsociado String?

  // DEUDA 104 (/cancel) — veredicto del courier ante un pedido de cancelación de Tiendanube. SEPARADO de `estado`
  // (que es el ciclo de vida de cara a Tiendanube). Estos 4 campos son el veredicto REAL del courier, persistido
  // para responder idempotente en los reintentos de Tiendanube: en el retry ya sabemos si el courier canceló o no
  // y no re-invocamos al courier — devolvemos el veredicto guardado.
  cancelacionEstado        String?   // null = sin pedido / en proceso; "OK" = courier canceló; "FAILED" = courier rechazó
  cancelacionReasonCode    String?   // reason.code cuando FAILED (LABEL_IN_TRANSIT, CARRIER_CANCELLATION_REJECTED, etc.)
  cancelacionReasonMessage String?   // mensaje humano del courier (data.message / data.msg) para ticket + auditoría
  cancelacionResueltaEn    DateTime? // cuándo el courier respondió (null = todavía no resuelto → aún puede correr el worker)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([envioId])
  @@index([fulfillmentOrderId])
  @@index([tiendaTiendanubeId])
}

// =============================================================================
// DEUDA 144 — TokenVinculacionTiendanube: token de un solo uso del install-link
// =============================================================================
// Mecanismo del "link de instalación" de Tiendanube (Momento 1). El operador Shipro
// genera un token para la empresa, el token viaja en el parámetro `state` del OAuth,
// y el callback lo valida (existe + no expiró + no se usó) para saber a qué empresa
// vincular la nueva tienda. Es tabla APARTE de TiendaTiendanube porque el token nace
// ANTES de que exista la tienda (no hay storeId todavía).
model TokenVinculacionTiendanube {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Token aleatorio que viaja en el `state` del OAuth de Tiendanube. Se genera cuando el operador
  // Shipro crea el link de instalación para una empresa (antes de que exista la tienda/storeId).
  // El callback lo valida: existe + no expiró (expira) + no se usó (usadoEn == null). @unique para
  // lookup O(1) en el callback. Reutiliza el patrón del correccionToken de Envio (randomBytes+base64url).
  token String @unique

  // Vencimiento del link de instalación (lo setea el endpoint que genera el link; el diseño sugiere
  // ~7 días). Un link vencido no vincula (defensa si el link se filtra o queda viejo).
  expira DateTime

  // Single-use: NULL hasta que el callback lo consume; entonces se setea al timestamp de uso. Un
  // token ya usado no vincula de nuevo. (A diferencia del correccionToken, que se auto-invalida por
  // estado, este token NO tiene un estado análogo → necesita el campo explícito.)
  usadoEn DateTime?

  createdAt DateTime @default(now())

  @@index([empresaId])
}
